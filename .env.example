# Project Atlas AI — environment configuration (12-Factor).
# Copy to `.env` and adjust. NEVER commit real secrets.

# ---- Application ----
ATLAS_APP_NAME="Project Atlas AI"
ATLAS_ENV=local            # local | staging | production
ATLAS_LOG_LEVEL=INFO

# ---- Adapter selection ----
# mock -> runs fully offline with deterministic data (default).
# real -> live market data via ATLAS_MARKET_DATA_SOURCE (below).
#         Fundamentals come from ATLAS_FUNDAMENTALS_SOURCE (feeds have none).
#         Broker still uses a mock adapter until its real adapter exists.
ATLAS_ADAPTER_MODE=mock

# ---- Market-data source (real mode only) ----
# kite  -> Zerodha Kite Connect (needs ATLAS_KITE_* below).
# yahoo -> public Yahoo Finance, no API key (needs outbound access to
#          query1.finance.yahoo.com; blocked by restricted-network sandboxes).
ATLAS_MARKET_DATA_SOURCE=kite

# ---- Fundamentals source (real mode only; price feeds don't provide fundamentals) ----
# mock  -> illustrative placeholders (logs a warning).
# file  -> read researched fundamentals from ATLAS_FUNDAMENTALS_PATH (JSON).
# yahoo -> public Yahoo Finance quoteSummary (no key; ROCE/promoter fields are
#          approximated, pledge unavailable — see docs). Needs outbound access.
ATLAS_FUNDAMENTALS_SOURCE=mock
ATLAS_FUNDAMENTALS_PATH=

# ---- Monte Carlo / prediction engine ----
ATLAS_MC_SIMULATIONS=10000
ATLAS_MC_SEED=42           # fixed seed keeps recommendations reproducible/auditable

# ---- LLM provider (debate/evidence narrative) ----
# mock       -> deterministic offline templated narrative (default).
# anthropic  -> Claude via the anthropic SDK (needs ATLAS_ANTHROPIC_API_KEY or an
#               `ant auth login` profile where deployed). `pip install -e ".[anthropic]"`.
ATLAS_LLM_PROVIDER=mock
ATLAS_ANTHROPIC_MODEL=claude-opus-5
ATLAS_ANTHROPIC_MAX_TOKENS=2048

ATLAS_OPENAI_API_KEY=
ATLAS_ANTHROPIC_API_KEY=
ATLAS_GEMINI_API_KEY=

# ---- Zerodha Kite Connect (unused in mock mode) ----
ATLAS_KITE_API_KEY=
ATLAS_KITE_API_SECRET=
ATLAS_KITE_ACCESS_TOKEN=
