# Project Atlas AI — environment configuration (12-Factor).
# Copy to `.env` and adjust. NEVER commit real secrets.

# ---- Application ----
ATLAS_APP_NAME="Project Atlas AI"
ATLAS_ENV=local            # local | staging | production
ATLAS_LOG_LEVEL=INFO

# ---- Adapter selection ----
# real -> LIVE data (default). Needs outbound network access.
# mock -> fully offline deterministic data (used only for tests / offline demos).
ATLAS_ADAPTER_MODE=real

# ---- Market-data source (real mode) ----
# yahoo -> public Yahoo Finance, no API key (default; needs outbound access to
#          query1.finance.yahoo.com; blocked by restricted-network sandboxes).
# kite  -> Zerodha Kite Connect (needs ATLAS_KITE_* below).
ATLAS_MARKET_DATA_SOURCE=yahoo

# ---- Fundamentals source (real mode only; price feeds don't provide fundamentals) ----
# yahoo -> public Yahoo Finance quoteSummary (default; no key; ROCE/promoter
#          fields approximated, pledge unavailable — see docs). Needs outbound access.
# file  -> read researched fundamentals from ATLAS_FUNDAMENTALS_PATH (JSON).
# mock  -> illustrative placeholders (logs a warning).
ATLAS_FUNDAMENTALS_SOURCE=yahoo
ATLAS_FUNDAMENTALS_PATH=

# ---- Macro source (real mode) ----
# yahoo -> live rupee/crude/global vars from Yahoo + the official figures below
#          (default). mock -> fixed snapshot.
ATLAS_MACRO_SOURCE=yahoo
# Official policy figures — update from RBI / MOSPI / NSE releases.
ATLAS_MACRO_REPO_RATE_PCT=6.5
ATLAS_MACRO_CPI_INFLATION_PCT=5.0
ATLAS_MACRO_GDP_GROWTH_PCT=6.5
ATLAS_MACRO_INDIA_10Y_YIELD_PCT=7.0
ATLAS_MACRO_FII_FLOW_CR=0.0

# ---- News source (real mode) ----
# google -> public Google News RSS + finance sentiment lexicon (default; no key;
#           needs outbound access to news.google.com). mock -> synthetic headlines.
ATLAS_NEWS_SOURCE=google
ATLAS_NEWS_QUERY_SUFFIX=share

# ---- Options source (real mode) ----
# nse  -> public NSE option-chain endpoint (default; no key; bot-protected, so
#         needs outbound access to www.nseindia.com and works only where deployed).
# mock -> deterministic synthetic option chain. A fetch failure degrades to a
#         neutral, no-signal options report either way.
ATLAS_OPTIONS_SOURCE=nse

# ---- Broker source (real mode) ----
# kite -> real Zerodha Kite holdings/margins (default; needs ATLAS_KITE_API_KEY
#         + ATLAS_KITE_ACCESS_TOKEN below). No key-less broker feed exists, so
#         real mode falls back to the mock broker (with a warning) if either is
#         unset. mock -> a small static portfolio.
ATLAS_BROKER_SOURCE=kite

# ---- Monte Carlo / prediction engine ----
ATLAS_MC_SIMULATIONS=10000
ATLAS_MC_SEED=42           # fixed seed keeps recommendations reproducible/auditable

# ---- LLM provider (debate/evidence narrative) ----
# anthropic  -> Claude via the anthropic SDK (default; needs ATLAS_ANTHROPIC_API_KEY
#               or an `ant auth login` profile, plus `pip install -e ".[anthropic]"`).
#               When the package/credentials are absent it falls back to the mock
#               (with a warning), so nothing crashes.
# mock       -> force the deterministic offline templated narrative.
ATLAS_LLM_PROVIDER=anthropic
ATLAS_ANTHROPIC_MODEL=claude-opus-5
ATLAS_ANTHROPIC_MAX_TOKENS=2048

ATLAS_OPENAI_API_KEY=
ATLAS_ANTHROPIC_API_KEY=
ATLAS_GEMINI_API_KEY=

# ---- Zerodha Kite Connect (unused in mock mode) ----
ATLAS_KITE_API_KEY=
ATLAS_KITE_API_SECRET=
ATLAS_KITE_ACCESS_TOKEN=
